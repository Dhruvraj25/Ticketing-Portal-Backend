[TEMPLATE]
# Database
DATABASE_URL=postgres://user:password@localhost:5432/supporthub

# Better Auth
BETTER_AUTH_URL=http://localhost:4000
BETTER_AUTH_SECRET=your-secret-key-change-this-in-production

# Server
PORT=4000
FRONTEND_URL=http://localhost:3000

# Cloudinary (optional - for file uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── Email ──────────────────────────────────────────────────────────────────
# Centralized email service. All application email goes through the backend
# email service, which delegates to the provider selected below.
#
# EMAIL_PROVIDER:
#   console        — (default) logs emails to the server console. Never contacts
#                    any external email service. Use for local development.
#   resend         — sends via the Resend API (requires RESEND_API_KEY).
#   microsoft-smtp — Microsoft 365 SMTP + OAuth 2.0 (XOAUTH2) via Nodemailer,
#                    smtp.office365.com:587 (STARTTLS). Production path.
#   microsoft      — DEPRECATED alias for microsoft-smtp (kept for compatibility).
EMAIL_PROVIDER=console
EMAIL_FROM=support@infinixotech.com
EMAIL_FROM_NAME=SupportHub

# Resend (legacy production provider — only needed if EMAIL_PROVIDER=resend)
# RESEND_API_KEY=

# Microsoft 365 SMTP — only needed if EMAIL_PROVIDER=microsoft-smtp.
# Reuses the EXISTING Entra application ("SMTP Oauth") — do NOT create a new one.
# Microsoft credentials are backend-only and must never be exposed to the
# frontend (no VITE_*/NEXT_PUBLIC_* variants).
#
# Exchange Online authorization is an administrator task (not automated):
#   - Office 365 Exchange Online API → Application permissions → SMTP.SendAsApp
#   - Admin consent
#   - Register the application service principal in Exchange Online
#   - Authorize the application to send as MICROSOFT_SENDER_EMAIL
#   - Verify SMTP AUTH is enabled for the mailbox/tenant
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_SENDER_EMAIL=support@infinixotech.com
MICROSOFT_SMTP_HOST=smtp.office365.com
MICROSOFT_SMTP_PORT=587

# Test recipient for the standalone SMTP test (Backend/test-microsoft-smtp.ts):
# TEST_EMAIL_TO=you@example.com

# Environment
NODE_ENV=development
